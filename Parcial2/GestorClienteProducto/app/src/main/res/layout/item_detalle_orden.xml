<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_menu_button"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

    <!-- NOMBRE PRODUCTO -->
    <TextView
        android:id="@+id/tvDetalleNombreProducto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Producto"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- CANTIDAD -->
    <TextView
        android:id="@+id/tvDetalleCantidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="x1"
        android:textColor="#9B6FD0"
        android:textSize="13sp"
        android:layout_marginEnd="12dp" />

    <!-- PRECIO -->
    <TextView
        android:id="@+id/tvDetallePrecio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00"
        android:textColor="#6B3F9E"
        android:textSize="12sp"
        android:layout_marginEnd="12dp" />

    <!-- SUBTOTAL -->
    <TextView
        android:id="@+id/tvDetalleSubtotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00"
        android:textColor="#00E5FF"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>