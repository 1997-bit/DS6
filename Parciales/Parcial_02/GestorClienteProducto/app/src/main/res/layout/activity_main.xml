<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A0A2E">

    <!-- Header de la app con el icono -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#2A0D4E"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- icono de un carrito-->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/shopping_cart"
            android:background="@drawable/bg_icon_pink"
            android:padding="8dp"
            android:contentDescription="Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestión de Órdenes"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistema de compras"
                android:textColor="#BF7FFF"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Boton de carrito -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">
            <!-- icono de carrito -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/shopping_cart"
                android:background="@drawable/bg_circle_pink"
                android:padding="20dp"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistema de Órdenes de Compra"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestiona clientes, productos y órdenes"
                android:textColor="#BF7FFF"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <!-- Boton para clientes -->
        <LinearLayout
            android:id="@+id/btnClientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_menu_button"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <!-- icono de de clientes-->
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_group"
                android:background="@drawable/bg_icon_cyan"
                android:padding="10dp"
                android:contentDescription="Clientes" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clientes"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestionar clientes"
                    android:textColor="#9B6FD0"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>
            <!-- flechita en la esquina de cada boton-->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"
                android:contentDescription="Ir"
                app:tint="#9B6FD0" />

        </LinearLayout>

        <!-- Boton para productos -->
        <LinearLayout
            android:id="@+id/btnProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_menu_button"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <!-- icono de productos-->

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_inventory"
                android:background="@drawable/bg_icon_purple"
                android:padding="10dp"
                android:contentDescription="Productos" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Productos"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestionar productos"
                    android:textColor="#9B6FD0"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>
            <!-- flechita en la esquina de cada boton-->

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"
                android:contentDescription="Ir"
                app:tint="#9B6FD0" />

        </LinearLayout>

        <!-- Boton para ordenes -->
        <LinearLayout
            android:id="@+id/btnOrdenes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_menu_button"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">
            <!-- icono de ordenes-->

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_receipt"
                android:background="@drawable/bg_icon_pink"
                android:padding="10dp"
                android:contentDescription="Órdenes" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Órdenes"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consultar órdenes"
                    android:textColor="#9B6FD0"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

            </LinearLayout>
            <!-- flechita en la esquina de cada boton-->

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_right"
                android:contentDescription="Ir"
                app:tint="#9B6FD0" />

        </LinearLayout>

        <!-- linea delgada dividiendo -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A0D4E"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!--boton para salir -->
        <LinearLayout
            android:id="@+id/btnSalir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_menu_button_outline"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_exit"
                android:background="@drawable/bg_icon_pink_dim"
                android:padding="10dp"
                android:contentDescription="Salir" />

            <!-- icono de salir-->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salir"
                android:textColor="#9B6FD0"
                android:textSize="14sp"
                android:layout_marginStart="14dp" />

        </LinearLayout>

        <!-- Pie de la app -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UTP · Desarrollo de Software VI"
            android:textColor="#6B3F9E"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:paddingBottom="8dp" />

    </LinearLayout>
    </ScrollView>

</LinearLayout>
