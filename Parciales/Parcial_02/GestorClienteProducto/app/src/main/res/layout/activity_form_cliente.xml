<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A0A2E">

    <!-- nabvar -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#2A0D4E"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- boton regresar -->

        <LinearLayout
            android:id="@+id/btnRegresar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_pink"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_left"
                android:contentDescription="Regresar" />

        </LinearLayout>

        <!-- Titulo -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nuevo Cliente"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />

        <!-- Botón guardar en el header -->
        <LinearLayout
            android:id="@+id/btnGuardar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_cyan"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <!-- boton de confirmar -->

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check"
                android:contentDescription="Guardar"
                app:tint="#00E5FF" />

        </LinearLayout>

    </LinearLayout>

    <!-- cuerpo -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <!-- cuadro de los campos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- campo nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre completo"
                android:textColor="#BF7FFF"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_menu_button"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_group"
                    android:contentDescription="Nombre"
                    app:tint="#9B6FD0" />

                <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej: María González"
                    android:textColorHint="#6B3F9E"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="@null"
                    android:layout_marginStart="10dp"
                    android:inputType="textPersonName" />

            </LinearLayout>
            <!--/campo nombre -->

            <!-- campo correo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Correo electrónico"
                android:textColor="#BF7FFF"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_menu_button"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_email"
                    android:contentDescription="Correo"
                    app:tint="#9B6FD0" />

                <EditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej: maria@correo.com"
                    android:textColorHint="#6B3F9E"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="@null"
                    android:layout_marginStart="10dp"
                    android:inputType="textEmailAddress" />

            </LinearLayout>
            <!--/campo correo -->

            <!-- campo telefono -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teléfono"
                android:textColor="#BF7FFF"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_menu_button"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_phone"
                    android:contentDescription="Teléfono"
                    app:tint="#9B6FD0" />

                <EditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej: 6000-0000"
                    android:textColorHint="#6B3F9E"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="@null"
                    android:layout_marginStart="10dp"
                    android:inputType="phone" />

            </LinearLayout>
            <!--/campo telefono -->

        </LinearLayout>

    </ScrollView>

</LinearLayout>