<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pantallaPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/layoutPrincipal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Conversor de Moneda"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#6C63FF"
            android:layout_marginBottom="16dp"/>

        <!-- Card ORIGEN -->
        <androidx.cardview.widget.CardView
            android:id="@+id/CardviewOrigen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:id="@+id/LinearL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/Monedat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moneda origen"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/selectorMonedaOrigen"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="10dp"/>

                <EditText
                    android:id="@+id/campoMonto"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:textSize="22sp"
                    android:gravity="end|center_vertical"
                    android:padding="12dp"/>

                <!-- SeekBar para precisión decimal -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Precisión decimal"
                        android:textSize="11sp"
                        android:textColor="#888888" />

                    <SeekBar
                        android:id="@+id/seekBarPrecision"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="4"
                        android:progress="2"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvPrecisionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 decimales"
                        android:textSize="10sp"
                        android:textColor="#6C63FF"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botón intercambiar -->
        <Button
            android:id="@+id/botonIntercambiar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginBottom="8dp"
            android:text=""
            android:backgroundTint="#6C63FF"
            android:drawableTop="@drawable/swap_vert"/>

        <!-- Card DESTINO -->
        <androidx.cardview.widget.CardView
            android:id="@+id/CardviewDestino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/LinearLDestino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvMonedaDestino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moneda destino"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="8dp"/>

                <Spinner
                    android:id="@+id/selectorMonedaDestino"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/etiquetaResultado"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="—"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#06D6A0"
                    android:gravity="end|center_vertical"
                    android:padding="12dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ProgressBar -->
        <ProgressBar
            android:id="@+id/progressBarConversion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal" />

        <!-- Botones -->
        <LinearLayout
            android:id="@+id/layoutBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/botonLimpiar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Limpiar"
                android:backgroundTint="#DDDDDD"
                android:textColor="#555555"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/botonConvertir"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Convertir"
                android:backgroundTint="#6C63FF"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Switch dark mode -->
        <LinearLayout
            android:id="@+id/layoutSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvModoOscuro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo oscuro"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginEnd="8dp"/>

            <Switch
                android:id="@+id/switchModoOscuro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Historial -->
        <TextView
            android:id="@+id/tvHistorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Historial"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="10dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaHistorial"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:nestedScrollingEnabled="true"
            tools:itemCount="3" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>