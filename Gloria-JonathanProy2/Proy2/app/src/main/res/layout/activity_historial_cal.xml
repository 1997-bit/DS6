<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp"
    android:id="@+id/main"
    android:background="#1A237E">

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Historial de Calificaciones"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <!-- Lista de registros (ocupa todo el espacio disponible) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Mensaje cuando no hay historial -->
            <TextView
                android:id="@+id/tvSinHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No hay registros guardados aún."
                android:textColor="#90CAF9"
                android:textSize="16sp"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone"/>

            <!-- Aquí el código llenará los registros dinámicamente -->
            <TextView
                android:id="@+id/tvHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:background="#0D1B6E"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Botón regresar siempre visible abajo -->
    <Button
        android:id="@+id/btnRegresarMenuHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Regresar al menú"
        android:backgroundTint="#37474F"
        android:layout_marginTop="12dp"/>

</LinearLayout>